# Cloudflare R2 (object storage — replaces Supabase Storage)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Preview / local test: set to `-test` and use matching R2 buckets (job-attachments-test, …).
# Leave unset on Production. Optional per-bucket overrides: R2_BUCKET_JOB_ATTACHMENTS, etc.
# R2_BUCKET_SUFFIX=-test

# Cloudflare Flagship (feature flags — server-side only)
# Dashboard: Compute → Flagship
# Use a separate Flagship app per environment (same flag keys, different App ID):
#   Production → app vestiqo (or current prod app)
#   Preview / Development / .env.local → app vestiqo-preview
# API token: My Profile → API Tokens (prefix cfut_), NOT Manage Account → Account API Tokens (cfat_).
# Custom token → Account → Flagship Read + Flagship Edit. Account tokens can evaluate but cannot list/toggle flags.
# Boolean flags: orders, contractor-services, calendar, new-tender-system, enhanced-map,
# advanced-filters, mobile-optimizations (on=true, off=false; default "on" when enabled)
FLAGSHIP_APP_ID=
CLOUDFLARE_FLAGSHIP_API_TOKEN=
# Public bucket URLs (enable public access on each bucket or attach a custom domain)
# For Preview/test use the *-test bucket public URLs (especially building-images-test).
NEXT_PUBLIC_R2_PUBLIC_URL_JOB_ATTACHMENTS=
NEXT_PUBLIC_R2_PUBLIC_URL_BUILDING_IMAGES=

# Supabase (database + auth)
# Local feature work: use vestiqo-test (hcnoqbnschbsxsjrbxao), NOT production.
# Production: vestiqo (fabbgaqxsetnsppxegnx) — Vercel Production only.
# See docs/environments.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (OPD-48 calendar reminders — daily 06:00 UTC).
# Production + Preview: set the same secret; Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Preview password gate (Vercel Preview only — never Production, never local .env.local)
# After a correct password, a signed httpOnly cookie is stored for 1 year.
# Vercel → Project → Settings → Environment Variables → Preview.
# PREVIEW_PASSWORD=

# Admin impersonation (signed httpOnly cookie — random 32+ bytes; required in production)
IMPERSONATION_COOKIE_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@vestiqo.pl

# GUS REGON API (company lookup by NIP — server-side only)
GUS_API_KEY=

# CEIDG v3 API (sole proprietorship registry — server-side only)
CEIDG_API_KEY=

# Email (optional)
RESEND_API_KEY=
# Transactional sender (password reset, verification rejection, contact-form notifications)
RESEND_FROM_EMAIL="Vestiqo <noreply@vestiqo.pl>"
# Inbox for /kontakt form submissions (defaults to kontakt@vestiqo.pl)
CONTACT_FORM_TO_EMAIL=

# PostHog (product analytics — EU cloud)
# Dashboard: https://eu.posthog.com → Project Settings → Project API key
# Client uses /ingest reverse proxy (see next.config.js rewrites); server uses NEXT_PUBLIC_POSTHOG_HOST directly.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (production / preview on Vercel)
# Live org/project: domio-ez / vestiqo — dashboard https://domio-ez.sentry.io
# 1. DSN: Project Settings → Client Keys (DSN) for vestiqo in org domio-ez
# 2. Org slug: SENTRY_ORG=domio-ez
# 3. Project slug: SENTRY_PROJECT=vestiqo
# 4. Auth token: https://domio-ez.sentry.io/settings/auth-tokens/ (scopes: org:read, project:releases)
#    Must belong to org domio-ez — a token from another org fails source-map upload with 401.
# Add all four to Vercel → Project → Settings → Environment Variables (Production + Preview).
# SENTRY_AUTH_TOKEN is required at build time for source map uploads.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
