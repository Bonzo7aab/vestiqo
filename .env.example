# Cloudflare R2 (object storage — replaces Supabase Storage)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Flagship (feature flags — server-side only)
# Dashboard: Compute → Flagship → app "domio" → copy App ID
# API token: My Profile → API Tokens → Custom → Account → Flagship Read
# Create boolean flags: new-tender-system, enhanced-map, advanced-filters, mobile-optimizations
FLAGSHIP_APP_ID=
CLOUDFLARE_FLAGSHIP_API_TOKEN=
# Public bucket URLs (enable public access on each bucket or attach a custom domain)
NEXT_PUBLIC_R2_PUBLIC_URL_JOB_ATTACHMENTS=
NEXT_PUBLIC_R2_PUBLIC_URL_BUILDING_IMAGES=

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# GUS REGON API (company lookup by NIP — server-side only)
GUS_API_KEY=

# CEIDG v3 API (sole proprietorship registry — server-side only)
CEIDG_API_KEY=

# Email (optional)
RESEND_API_KEY=
# Transactional sender (password reset, verification rejection, contact-form notifications)
RESEND_FROM_EMAIL="Vestiqo <noreply@vestiqo.pl>"
# Inbox for /kontakt form submissions (defaults to kontakt@vestiqo.pl)
CONTACT_FORM_TO_EMAIL=

# PostHog (product analytics — EU cloud)
# Dashboard: https://eu.posthog.com → Project Settings → Project API key
# Client uses /ingest reverse proxy (see next.config.js rewrites); server uses NEXT_PUBLIC_POSTHOG_HOST directly.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (production / preview on Vercel)
# 1. Create project at https://sentry.io — platform: Next.js
# 2. DSN: Project Settings → Client Keys (DSN)
# 3. Org slug: URL sentry.io/organizations/<org-slug>/
# 4. Project slug: Project Settings → General
# 5. Auth token: https://sentry.io/settings/auth-tokens/ (scopes: org:read, project:releases)
# Add all four to Vercel → Project → Settings → Environment Variables (Production + Preview).
# SENTRY_AUTH_TOKEN is required at build time for source map uploads.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
